<Window x:Class="ZhengxinOCR.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="正心OCR" Width="820" Height="670" MinWidth="700" MinHeight="580" Background="#F7F8FA" Foreground="#2A3F52" Closing="OnClosing">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="14,7"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
  <Style x:Key="PathButton" TargetType="Button">
   <Setter Property="Width" Value="36"/><Setter Property="Height" Value="32"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#2A3F52"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" Padding="9"><Path Stroke="{TemplateBinding Foreground}" StrokeThickness="2" Data="M 7,0 A 7,7 0 1 1 6.99,0 M 12,12 L 18,18" Stretch="Uniform"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#CEBA7B"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="#CEBA7B"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <DockPanel Margin="24">
  <StackPanel DockPanel.Dock="Top">
   <DockPanel><TextBlock Text="正心OCR" FontSize="28" FontWeight="SemiBold"/><Button Content="帮助" HorizontalAlignment="Right" Click="HelpClick"/></DockPanel>
   <TextBlock Text="本地文献识别 · Windows 通用安装版" Margin="0,6,0,18"/>
   <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="85"/><ColumnDefinition/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
    <TextBlock Text="输入文件" VerticalAlignment="Center"/><TextBox x:Name="Input" Grid.Column="1" Padding="7"/><Button Grid.Column="2" Style="{StaticResource PathButton}" ToolTip="选择 PDF 或图像" AutomationProperties.Name="选择输入文件" Click="ChooseInput"/>
   </Grid>
   <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="85"/><ColumnDefinition/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
    <TextBlock Text="输出目录" VerticalAlignment="Center"/><TextBox x:Name="Output" Grid.Column="1" Padding="7"/><Button Grid.Column="2" Style="{StaticResource PathButton}" ToolTip="选择输出目录" AutomationProperties.Name="选择输出目录" Click="ChooseOutput"/>
   </Grid>
   <DockPanel Margin="0,0,0,12"><TextBlock Text="识别模式" Width="85" VerticalAlignment="Center"/><ComboBox x:Name="Mode" SelectedIndex="0" Padding="5"><ComboBoxItem Content="普通扫描" Tag="modern"/><ComboBoxItem Content="复杂排版" Tag="complex"/><ComboBoxItem Content="古籍正本" Tag="ancient"/></ComboBox></DockPanel>
   <TextBlock Text="逐页处理并保存结果；普通扫描自动检测可直接提取的原生文字。" TextWrapping="Wrap" Margin="0,0,0,12"/>
   <WrapPanel Margin="0,0,0,15"><Button x:Name="Start" Content="开始识别" Click="StartClick" IsEnabled="False"/><Button x:Name="Cancel" Content="取消任务" Click="CancelClick" IsEnabled="False"/><Button Content="显示结果" Click="ShowOutput"/><Button x:Name="Repair" Content="检查 / 修复环境" Click="RepairClick" IsEnabled="False"/></WrapPanel>
   <TextBlock x:Name="Status" Text="正在检查运行环境…" TextWrapping="Wrap"/>
   <ProgressBar x:Name="Progress" Height="6" Margin="0,10,0,8" Maximum="100"/>
   <TextBlock x:Name="Counts" Margin="0,0,0,12"/>
  </StackPanel>
  <TextBox x:Name="Log" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Padding="10" Background="White"/>
 </DockPanel>
</Window>
